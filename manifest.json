{
  "manifest_version": 3,
  "name": "LM Companion",
  "description": "What's due, what's missing and what changed on XJTLU Learning Mall. Runs in your browser; nothing leaves it.",
  "version": "0.4.0",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://core.xjtlu.edu.cn/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LM Companion"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://core.xjtlu.edu.cn/my/",
        "https://core.xjtlu.edu.cn/my/index.php*"
      ],
      "js": [
        "src/content/panel.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/view.js",
        "src/lib/i18n.js",
        "src/lib/calendar.js",
        "src/lib/sync.js",
        "src/lib/moodle.js"
      ],
      "matches": [
        "https://core.xjtlu.edu.cn/*"
      ]
    }
  ],
  "key": "",
  "optional_permissions": [
    "history"
  ]
}