{
  "manifest_version": 3,
  "name": "XJTLU Learning Mall Companion",
  "description": "XJTLU Learning Mall (Moodle) deadlines, daily checklist and reminders. 西浦 Learning Mall 截止日期与提醒。",
  "version": "0.7.1",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "https://core.xjtlu.edu.cn/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "XJTLU Learning Mall Companion"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://core.xjtlu.edu.cn/my/",
        "https://core.xjtlu.edu.cn/my/index.php*"
      ],
      "js": [
        "src/content/panel.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/view.js",
        "src/lib/i18n.js",
        "src/lib/calendar.js",
        "src/lib/reminders.js",
        "src/lib/time.js",
        "src/lib/sync.js",
        "src/lib/moodle.js",
        "src/lib/bar.js"
      ],
      "matches": [
        "https://core.xjtlu.edu.cn/*"
      ]
    }
  ],
  "key": "",
  "optional_permissions": [
    "notifications",
    "history",
    "nativeMessaging"
  ]
}
